{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zázrak next-task suggestion response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "suggestions",
    "provider",
    "model",
    "retryAfterMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ready",
        "setup",
        "empty",
        "waiting",
        "error"
      ]
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "prompt",
          "reason",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "provider": {
      "const": "groq"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "retryAfterMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "revision",
        "scannedAt",
        "fileCount",
        "sampledFileCount",
        "partial"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scannedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "sampledFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "partial": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "message": {
      "type": "string"
    },
    "cached": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "required": [
          "project",
          "summary",
          "cached",
          "generatedAt"
        ],
        "properties": {
          "suggestions": {
            "minItems": 3
          }
        }
      },
      "else": {
        "properties": {
          "suggestions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
