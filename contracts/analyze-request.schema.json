{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflight.local/contracts/analyze-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "app": {
      "type": "string",
      "maxLength": 200
    },
    "maxSkills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  }
}
