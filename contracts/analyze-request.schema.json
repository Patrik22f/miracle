{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflight.local/contracts/analyze-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "app": {
      "type": "string",
      "maxLength": 200
    },
    "maxSkills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationId",
        "source",
        "messages"
      ],
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "enum": [
            "manual",
            "accessibility",
            "claude-transcript"
          ]
        },
        "messages": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant",
                  "context"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
