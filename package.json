{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch api/src/server.js",
    "start": "node api/src/server.js",
    "test": "node --test api/test/*.test.js",
    "macos:build": "bash scripts/build-macos.sh",
    "macos:test": "swift test --package-path macos --build-system native",
    "check": "npm test && npm run macos:test",
    "smoke": "node scripts/smoke.js"
  }
}
