# No API key or npm dependencies required. Copy to .env in the repo root.
PORT=8787
# hybrid = imported installed/public skills plus live skills.sh discovery (default).
# installed = imported installed skills only; no network during analysis.
# live = legacy public search; offline = legacy six-entry fallback catalog.
SKILLS_MODE=hybrid
SKILLS_TIMEOUT_MS=2500
# Model profiles are advisory; the client does not change the host app's model.
