# Local analysis needs no key. Official Skills API sync requires Vercel OIDC.
PORT=8787
# knowledge = local content index, no network during analysis (default).
# hybrid/installed = legacy criteria-v2; live/offline = legacy heuristic-v1.
SKILLS_MODE=knowledge
SKILLS_TIMEOUT_MS=2500
# Optional short-lived token for npm run skills:import -- --api or --discover.
# Keep credentials in your environment; never commit them.
# VERCEL_OIDC_TOKEN=
